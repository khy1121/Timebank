# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 저장소에 올리지 않는다.
# Supabase 대시보드 > Project Settings > API 에서 확인한다.
# 공개용 키(sb_publishable_...)만 넣는다. 관리자 키(service_role, sb_secret_...)는 절대 넣지 않는다.
EXPO_PUBLIC_SUPABASE_URL=https://<프로젝트 ID>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 의견 보내기와 처리방침의 문의 주소. 비워 두면 기본값 todobank.help@gmail.com(domain/settings.ts)을 쓴다.
EXPO_PUBLIC_CONTACT_EMAIL=

# 오류 모니터링(Sentry). 앱 안에 들어가는 공개 주소라 괜찮다. 비워 두면 오류를 보내지 않는다.
# Sentry > Settings > Projects > todo-interest > Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=
# 소스맵 업로드용 토큰(SENTRY_AUTH_TOKEN)은 비밀이다. 여기 말고 .env.local 이나 EAS 환경 변수에만 넣는다.
